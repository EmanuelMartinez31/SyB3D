<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- r90 · League Broadcast se ha actualizado y sus librerias ahora son de
         .NET 11 (System.Runtime 11.0.0.0). Para poder referenciarlas hay que
         compilar tambien contra .NET 11: con net10.0 el compilador lo rechaza
         con CS1705. -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SyBSensor</AssemblyName>
    <LbDir>C:\Users\31ema\AppData\Local\LeagueBroadcast\current\</LbDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Farsight"><HintPath>$(LbDir)Farsight.dll</HintPath></Reference>
    <Reference Include="BlueBottleClient.Common"><HintPath>$(LbDir)BlueBottleClient.Common.dll</HintPath></Reference>
    <Reference Include="BlueBottleClient.GameLib"><HintPath>$(LbDir)BlueBottleClient.GameLib.dll</HintPath></Reference>
    <Reference Include="AWSSDK.Core"><HintPath>$(LbDir)AWSSDK.Core.dll</HintPath></Reference>
    <Reference Include="AWSSDK.CognitoIdentity"><HintPath>$(LbDir)AWSSDK.CognitoIdentity.dll</HintPath></Reference>
    <Reference Include="AWSSDK.S3"><HintPath>$(LbDir)AWSSDK.S3.dll</HintPath></Reference>
    <Reference Include="FlatSharp.Runtime"><HintPath>$(LbDir)FlatSharp.Runtime.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(LbDir)Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
  </ItemGroup>
  <!-- r90 · Lo que se copia al lado del ejecutable. Todo con comodines: si en la
       carpeta de League Broadcast falta algo (por ejemplo lblib.dll, que en la
       version nueva ya no viene suelta: se descarga por parche del juego), el
       comodin simplemente no la encuentra y NO rompe la compilacion. -->
  <ItemGroup>
    <LbDeps Include="$(LbDir)Farsight.dll" />
    <LbDeps Include="$(LbDir)BlueBottleClient*.dll" />
    <LbDeps Include="$(LbDir)lblib*.dll" />
    <LbDeps Include="$(LbDir)FlatSharp*.dll" />
    <LbDeps Include="$(LbDir)Microsoft.Extensions.Logging*.dll" />
    <LbDeps Include="$(LbDir)AWSSDK*.dll" />
    <LbDeps Include="$(LbDir)System.IdentityModel.Tokens.Jwt.dll" />
    <LbDeps Include="$(LbDir)Microsoft.IdentityModel*.dll" />
    <LbDeps Include="$(LbDir)System.Reactive*.dll" />
    <LbDeps Include="$(LbDir)Microsoft.IO.RecyclableMemoryStream*.dll" />
    <LbDeps Include="$(LbDir)ZstdSharp.dll" />
    <LbDeps Include="$(LbDir)System.IO.Hashing.dll" />
  </ItemGroup>
  <Target Name="CopyLbDeps" AfterTargets="Build" BeforeTargets="Run">
  <Copy SourceFiles="@(LbDeps)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
</Target>
</Project>
